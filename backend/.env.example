# ==============================================================================
# Smart Solar Microgrid Trading System - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env (or configure in launchSettings.json / Docker / environment)
# Note: ASP.NET Core maps double-underscore (__) delimited variables to nested JSON configuration.

# --- ASP.NET Core Server ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# --- MongoDB Database ---
# Local MongoDB: mongodb://localhost:27017
# Atlas MongoDB: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=SmartSolarMicrogridDb

# --- JWT Authentication Settings ---
# SigningKey must contain at least 32 bytes (32+ characters)
Jwt__Issuer=SmartSolarMicrogrid.Api
Jwt__Audience=SmartSolarMicrogrid.Clients
Jwt__SigningKey=SuperSecretSmartSolarMicrogridKey2026!@#$
Jwt__ExpirationMinutes=60

# --- Initial Backoffice Admin Account Bootstrap ---
# Automatically creates the initial Backoffice user on first run if no account exists
BootstrapAdmin__FirstName=Admin
BootstrapAdmin__LastName=System
BootstrapAdmin__Email=admin@smartsolar.local
BootstrapAdmin__Phone=+94770000000
BootstrapAdmin__Password=AdminStrongP@ssw0rd!2026

# --- Development Seed Data (Development Only) ---
# Set Enabled=true to seed test station, Grid Operator, Prosumer, slots, and reservations on startup
DevelopmentSeed__Enabled=true
DevelopmentSeed__OperatorPassword=OperatorDevP@ssw0rd!2026
DevelopmentSeed__ProsumerPassword=ProsumerDevP@ssw0rd!2026

# --- CORS Allowed Origins ---
# Frontend Vite dev server origin
Cors__AllowedOrigins__0=http://localhost:5173
