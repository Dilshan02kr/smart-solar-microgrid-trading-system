<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/launchFragment">

    <fragment
        android:id="@+id/launchFragment"
        android:name="com.smartsolar.microgrid.ui.launch.LaunchFragment"
        android:label="@string/launch_title">
        <action
            android:id="@+id/action_launchFragment_to_foundationFragment"
            app:destination="@id/foundationFragment"
            app:popUpTo="@id/launchFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/foundationFragment"
        android:name="com.smartsolar.microgrid.ui.common.FoundationFragment"
        android:label="@string/foundation_title" />
</navigation>

